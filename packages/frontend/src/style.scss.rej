--- packages/frontend/src/style.scss	2026-09-23 17:23:27.000000000 +0900
+++ packages/frontend/src/style.scss	2026-09-29 11:46:15.238142218 +0900
@@ -754,3 +754,18 @@
 	0% { filter: hue-rotate(0deg) contrast(150%) saturate(150%); }
 	100% { filter: hue-rotate(360deg) contrast(150%) saturate(150%); }
 }
+
+// Shared by navigation, menu settings and the Fuji3Chat page header.
+._fuji3chatIcon {
+	display: inline-block;
+	line-height: 1;
+
+	&::before {
+		content: '';
+		display: inline-block;
+		width: 1em;
+		height: 1em;
+		vertical-align: -0.125em;
+		background: url('./assets/fuji3chat.png') center / contain no-repeat;
+	}
+}
